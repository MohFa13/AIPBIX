{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "target": "ES6",
    "module": "ES6",
    "moduleResolution": "node",
    "lib": ["ES2015", "DOM"],
    "types": ["powerbi-visuals-api"],
    "outDir": "./.tmp/build/",
    "sourceMap": true,
    "declaration": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "files": [
    "src/visual.ts",
    "src/settings.ts"
  ],
  "include": ["src/**/*"],
  "exclude": ["node_modules", ".tmp", "dist"]
}
